[Unit]
Description=AWS Signing Helper credential server for Agentgateway
Documentation=https://docs.aws.amazon.com/rolesanywhere/latest/userguide/credential-helper.html
After=network-online.target
Wants=network-online.target
Before=agentgateway.service

[Service]
Type=simple
User={{ user }}
Group={{ group }}
ExecStart=/usr/local/bin/aws_signing_helper serve \
  --certificate {{ certificate_path }} \
  --private-key {{ private_key_path }} \
  --trust-anchor-arn {{ trust_anchor_arn }} \
  --profile-arn {{ profile_arn }} \
  --role-arn {{ role_arn }} \
  --region {{ region }} \
  --port {{ port }}
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/{{ user }}/.config/agentgateway
PrivateTmp=true

[Install]
WantedBy=multi-user.target
