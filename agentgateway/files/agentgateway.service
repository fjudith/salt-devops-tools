[Unit]
Description=Agentgateway - AI-native proxy for MCP & A2A
Documentation=https://agentgateway.dev/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
ExecStart={{ bin_dir }}/agentgateway -f /home/{{ user }}/.config/agentgateway/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/{{ user }}/.config/agentgateway
PrivateTmp=true

[Install]
WantedBy=multi-user.target
