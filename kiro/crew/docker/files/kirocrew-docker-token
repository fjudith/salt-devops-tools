#!/bin/bash
# -*- coding: utf-8 -*-
# Managed by Salt (kiro/crew docker mode).
#
# Print a KiroCrew dashboard access URL with a fresh auth token, generated
# inside the running container. Paste the printed URL into your browser.
#
# Usage: sudo kirocrew-docker-token [TTL]
#   TTL  optional token lifetime (e.g. 2h, 30m). Default: {{ default_ttl }}.
set -euo pipefail

CONTAINER="{{ container }}"
PORT="{{ port }}"
HOST_IP="{{ host_ip }}"
TTL="${1:-{{ default_ttl }}}"

if ! docker ps --format '{{ '{{' }}.Names{{ '}}' }}' | grep -qx "${CONTAINER}"; then
  echo "Container '${CONTAINER}' is not running. Start it with:" >&2
  echo "  sudo systemctl start {{ service }}" >&2
  exit 1
fi

# kirocrew token prints a URL like http://localhost:PORT?token=...
url="$(docker exec "${CONTAINER}" /usr/local/bin/kirocrew token --port "${PORT}" --ttl "${TTL}" \
  | grep -oE 'https?://[^[:space:]]+' | tail -1)"

if [ -z "${url}" ]; then
  echo "Failed to obtain a token from the container." >&2
  exit 1
fi

# Rewrite the host to the address published on this host so the link is
# reachable from a browser (including via WSL2 -> Windows localhost forwarding).
url="${url/#http:\/\/localhost/http://${HOST_IP}}"
url="${url/#http:\/\/0.0.0.0/http://${HOST_IP}}"

echo "Open this URL in your browser (valid for ${TTL}):"
echo "${url}"
