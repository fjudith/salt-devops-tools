  trivy:
    enabled: true

falcosecurity:
  falco:
    enabled: false

opentofu:
  cli:
    enabled: true

hashicorp:
  terraform:
    cli:
      enabled: true

pulumi:
  cli:
    enabled: true

kubernetes:
  cli:
    enabled: true
  helm:
    enabled: true
  azure:
    kubelogin:
      enabled: true
  k9s:
    enabled: true
  kind:
    enabled: true
  kustomize:
    enabled: true

istio:
  cli:
    enabled: false

cilium:
  cli:
    enabled: false
  hubble:
    enabled: fasle

kyverno:
  cli:
    enabled: false

pixie:
  cli:
    enabled: false

ldap:
  enabled: true

aws:
  cli:
    enabled: false
  nuke:
    enabled: false
  samcli:
    enabled: false
  eksctl:
    enabled: false
  rolesanywhere:
    ca:
      enabled: false
      ca_cert:
        cn: "My Org IAM Roles Anywhere CA"
        O: "My Organization"
        OU: "Platform Engineering"
        C: "US"
        ST: "California"
        L: "San Francisco"
      certificates:
        example-workload:
          cn: "workload.example.com"
          days_valid: 365
          days_remaining: 30

kiro:
  cli:
    enabled: false
  crew:
    enabled: false
    service:
      enabled: false
      # mode: native | docker | kata
      mode: native
      user: your-user
      bin: kirocrew
      docker:
        image: ghcr.io/kirodotdev/kirocrew:stable
        container: kirocrew
        volume: kirocrew-home
        # Dashboard published on host_ip:port -> container 5476.
        port: 5476
        host_ip: 127.0.0.1
        # systemd unit that manages the container lifecycle.
        service: kirocrew-docker
        # CPU / memory bounds. null omits the flag. Keep memory.max >= 4g.
        resources:
          cpu:
            max: 4          # docker run --cpus (hard ceiling, cores)
            min: null       # docker run --cpu-shares (soft weight)
          memory:
            max: 4g         # docker run --memory (hard limit)
            min: 2g         # docker run --memory-reservation (soft floor)
        # Default TTL for dashboard tokens (kirocrew-docker-token).
        token_ttl: 2h
        # Host directories bind-mounted into the container. Each entry is a
        # dict of source/target with an optional read_only flag. Read-write
        # sources are created on the host and chowned to uid/gid. Default is an
        # empty list (no host mounts). SECURITY: mounting ~/.aws overrides the
        # entrypoint's default masking and hands AWS creds to the agent; mount
        # it read_only.
        mounts:
          - source: /home/you/git
            target: /workspace
          - source: /home/you/.aws
            target: /home/kirocrew/.aws
            read_only: true
        # Run in the host user namespace so the container can read/write host
        # bind-mounts (needed when the daemon uses userns-remap). Set false to
        # keep userns-remap isolation (host mounts become read-only).
        userns_host: true
        uid: 1000
        gid: 1000
      # kata mode runs the KiroCrew OCI image inside a Kata Containers micro-VM
      # (Cloud Hypervisor backend). Requires kata-containers.enabled below.
      kata:
        image: ghcr.io/kirodotdev/kirocrew:stable
        container: kirocrew
        # Dashboard published on host_ip:port -> container 5476 via CNI portmap.
        port: 5476
        host_ip: 127.0.0.1
        runtime: io.containerd.kata-clh.v2
        namespace: kirocrew
        service: kirocrew-kata
        # CPU / memory bounds. null omits the flag. With the Kata clh backend
        # cpu.max and memory.max size the micro-VM. Keep memory.max >= 4g.
        resources:
          cpu:
            max: 4          # nerdctl run --cpus (hard ceiling / VM vCPUs)
            min: null       # nerdctl run --cpu-shares (soft weight)
          memory:
            max: 4g         # nerdctl run --memory (hard limit / guest RAM)
            min: 2g         # nerdctl run --memory-reservation (soft floor)
        # Default TTL for dashboard tokens (kirocrew-kata-token).
        token_ttl: 2h
        # Dedicated CNI network + fixed container IP. A systemd socket proxy
        # on host_ip:port forwards to container_ip:port so WSL2 mirrors the
        # dashboard to Windows while keeping Kata VM isolation.
        network: kirocrew
        subnet: 10.88.0.0/24
        container_ip: 10.88.0.10
        proxy_service: kirocrew-kata-proxy
        # Host directories shared into the guest (virtio-fs). Each entry is a
        # dict of source/target with an optional read_only flag. Overriding
        # this list replaces the default workspace share. SECURITY: mounting
        # ~/.aws hands AWS creds to the agent; mount it read_only.
        mounts:
          - source: /var/lib/kirocrew/shared
            target: /workspace
          - source: /home/you/.aws
            target: /home/kirocrew/.aws
            read_only: true
        # Persistent container home (KiroCrew state + kiro-cli login creds).
        home_dir: /var/lib/kirocrew/home
        home_mount: /home/kirocrew
        home_uid: 1000
        home_gid: 1000

# Kata Containers with the Cloud Hypervisor (clh) backend. Required for the
# kirocrew `kata` service mode above. Needs KVM (/dev/kvm).
kata-containers:
  kata-containers:
    enabled: false

# nerdctl (Docker-compatible containerd CLI). Required for the kirocrew `kata`
# service mode, which uses it for CNI networking and port publishing.
containerd:
  nerdctl:
    enabled: false

cloud-hypervisor:
  cloud-hypervisor:
    enabled: false

